{
  "name": "shelem-online",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently --kill-others -n web,game,media \"npm:dev\" \"npm:server\" \"npm:media\"",
    "media": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-livekit.ps1",
    "server": "node server/index.mjs",
    "test:server": "node --test server/integration.test.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "livekit-client": "^2.21.0",
    "livekit-server-sdk": "^2.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "concurrently": "^9.2.4"
  }
}
