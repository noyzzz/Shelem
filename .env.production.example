# Public DNS names. Both A records must point to the VPS public IP.
APP_DOMAIN=play.example.com
LIVEKIT_DOMAIN=livekit.example.com

# Generate unique values during deployment. Never commit the real secret.
LIVEKIT_API_KEY=replace-with-a-random-api-key
LIVEKIT_API_SECRET=replace-with-a-long-random-api-secret

# Choose a strong password for the database user (never reuse the LiveKit secret).
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Optional Google sign-in. Create a Web Client ID at
# https://console.cloud.google.com/apis/credentials and add your domain to the
# "Authorized JavaScript origins" list. The ID is public; no secret is needed.
GOOGLE_CLIENT_ID=
