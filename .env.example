# Local Docker defaults work without this file. Replace all three values in
# production and never commit the real secret.
LIVEKIT_API_KEY=replace-with-a-production-api-key
LIVEKIT_API_SECRET=replace-with-a-long-random-production-secret
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_NODE_IP=replace-with-your-server-public-ip
